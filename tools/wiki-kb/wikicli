#!/usr/bin/env python3
"""wikicli — low-noise OSRS-wiki access for research agents.

The wiki is the SINGLE SOURCE OF TRUTH for guide-chain research. This CLI
talks to the MediaWiki API (wikitext, never HTML scraping), caches every
fetch as a blob, and keeps idempotent append-only ledgers so parallel agents
never duplicate work and findings accumulate across sessions.

Layout (everything lives beside this script):
  blobs/<slug>.wiki    cached raw wikitext (slug = urlsafe title)
  manifest.jsonl       {slug,title,url,sha1,bytes,fetched} per blob
  contrib.jsonl        findings ledger — append-only, idempotent on "key"
  queue.jsonl          work queue — append-only, last status per key wins
  cli-feedback.log     improvement suggestions from agents (always welcome)
  gotchas.log          process gotchas from agents
  retro.log            per-agent retro blocks

Commands (stdout = data, stderr = status; pipe-friendly):
  search <terms...>            title candidates (opensearch)
  get <title> [--section N] [--strip]
                               wikitext, cached (run `sections` first on big pages);
                               --strip = low-noise view (drops GE prices/File refs/<ref>,
                               unwraps {{Checklist}}, compacts {{Map}} -> «map» coord
                               lines; coords/quantities/steps always preserved)
  sections <title>             numbered section map (index  bytes  name)
  links <title>                outgoing article links (breadcrumbs)
  members <category>           pages in a Category:... (breadth traversal)
  url <title>                  canonical url for citations
  manifest [substr]            cached blobs (optionally filtered)
  contribute '<json>'          append finding iff its "key" is unseen
  contribute --file <path>     same, JSON read from a file (no shell-quoting pain)
  queue add <key> ['<json>']   idempotent enqueue
  queue claim <key>            mark claimed (append-only)
  queue done <key> ['<json>']  mark done
  queue list [status]          resolved queue state
  feedback '<text>'            suggest a CLI improvement (please do)
"""
import hashlib
import json
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

API = "https://oldschool.runescape.wiki/api.php"
BASE = "https://oldschool.runescape.wiki/w/"
UA = "guide-chain-kb/1.0 (research tooling for a RuneLite guide plugin)"
ROOT = Path(__file__).resolve().parent
BLOBS = ROOT / "blobs"
CACHE = ROOT / "cache"   # raw API-response cache: EVERY request hits disk first
LEDGERS = {
    "manifest": ROOT / "manifest.jsonl",
    "contrib": ROOT / "contrib.jsonl",
    "queue": ROOT / "queue.jsonl",
    "feedback": ROOT / "cli-feedback.log",
}
TIMEOUT_S = 25


def say(msg):
    print(msg, file=sys.stderr)


def die(msg):
    sys.exit(f"wikicli: {msg}")


def now():
    return subprocess.run(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"],
                          capture_output=True, text=True).stdout.strip()


def api(params):
    """One API call — but idempotent on disk: identical requests are served from
    cache/ and NEVER re-hit the wiki (be a polite citizen of the knowledge base)."""
    params = {**params, "format": "json", "formatversion": "2"}
    query = urllib.parse.urlencode(sorted(params.items()))
    hit = CACHE / (hashlib.sha1(query.encode()).hexdigest()[:16] + ".json")
    if hit.exists():
        say(f"api cache hit: {hit.name}")
        return json.loads(hit.read_text())
    req = urllib.request.Request(API + "?" + query, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
        data = json.load(resp)
    err = data.get("error") if isinstance(data, dict) else None   # opensearch returns a list
    if err:
        die(f"wiki error: {err.get('info', err)}")
    CACHE.mkdir(exist_ok=True)
    hit.write_text(json.dumps(data))
    return data


def slugify(title):
    safe = re.sub(r"[^A-Za-z0-9()'+._-]+", "_", title.replace(" ", "_"))
    return safe.strip("_") or hashlib.sha1(title.encode()).hexdigest()[:12]


def canonical_url(title):
    return BASE + urllib.parse.quote(title.replace(" ", "_"), safe="_()'+:/")


def append_ledger(name, line):
    path = LEDGERS[name]
    with path.open("a") as f:
        f.write(line.rstrip("\n") + "\n")


def ledger_rows(name):
    path = LEDGERS[name]
    if not path.exists():
        return []
    rows = []
    for raw in path.read_text().splitlines():
        raw = raw.strip()
        if raw and not raw.startswith("#"):
            rows.append(json.loads(raw))
    return rows


def parse_json_arg(raw, what):
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"bad {what} json: {e}")


# ── strip view (NOISEBENCH-gated: never lose coords/quantities/steps) ─────────

def _template_spans(text, name):
    """(start, end) spans of balanced {{name ...}} blocks (handles nesting)."""
    spans = []
    for m in re.finditer(r"\{\{\s*" + name + r"\b", text, flags=re.I):
        end = _matching_close(text, m.start())
        if end:
            spans.append((m.start(), end))
    return spans


def _matching_close(text, start):
    depth, i = 0, start
    while i < len(text) - 1:
        pair = text[i:i + 2]
        if pair == "{{":
            depth, i = depth + 1, i + 2
            continue
        if pair == "}}":
            depth, i = depth - 1, i + 2
            if depth == 0:
                return i
            continue
        i += 1
    return None


def _compact_maps(text):
    """{{Map ...}} -> one '«map» (x,y) desc; ...' line. Unknown coord dialect ->
    keep the block verbatim (never silently lose coordinates)."""
    for start, end in reversed(_template_spans(text, "Map")):
        block = text[start:end]
        pins = re.findall(r"x[:=]\s*(\d+)[,|\s]+y[:=]\s*(\d+)(?:,icon:[^,\n|]*)?(?:,desc:([^|}\n]*))?", block)
        if not pins:
            continue
        line = "«map» " + "; ".join(f"({x},{y}){' ' + d.strip() if d else ''}" for x, y, d in pins)
        text = text[:start] + line + text[end:]
    return text


def _unwrap_checklists(text):
    """{{Checklist|*a\n*b}} -> the bare bullets (wrapper off, steps intact)."""
    for start, end in reversed(_template_spans(text, "Checklist")):
        inner = re.sub(r"^\{\{\s*Checklist\s*\|?", "", text[start:end - 2], flags=re.I)
        text = text[:start] + inner + text[end:]
    return text


def strip_noise(text):
    """--strip: cut render noise, KEEP load-bearing data. Drops GE prices, File/Image
    refs, <ref> tags; unwraps Checklist; compacts Map to coord lines; collapses
    [[link|label]] -> label. Infoboxes are kept — they carry ids/levels/data."""
    text = re.sub(r"<ref[^>/]*>.*?</ref>|<ref[^>/]*/>", "", text, flags=re.S)
    text = re.sub(r"\[\[(?:File|Image):[^\]]*\]\]", "", text)
    for _ in range(3):   # innermost-out: {{Coins|{{GEP|..}}}} needs a second pass
        text = re.sub(r"\{\{(?:GEP?|GEPrice|Coins)\|[^{}]*\}\}", "", text)
    text = _compact_maps(text)
    text = _unwrap_checklists(text)
    text = re.sub(r"\[\[([^|\]]*)\|([^\]]*)\]\]", r"\2", text)
    text = re.sub(r"\[\[([^\]]*)\]\]", r"\1", text)
    return re.sub(r"\n{3,}", "\n\n", text)


# ── commands ──────────────────────────────────────────────────────────────────

def cmd_search(args):
    if not args:
        die("search needs terms")
    data = api({"action": "opensearch", "search": " ".join(args), "limit": "12"})
    titles, urls = data[1], data[3]
    for title, url in zip(titles, urls):
        print(f"{title}\t{url}")


def cmd_get(args):
    strip = "--strip" in args
    args = [a for a in args if a != "--strip"]
    title, section = _title_and_section(args)
    slug = slugify(title) + (f".s{section}" if section else "")
    blob = BLOBS / f"{slug}.wiki"
    if blob.exists():
        say(f"cache hit: blobs/{blob.name} ({blob.stat().st_size}B)")
        print(strip_noise(blob.read_text()) if strip else blob.read_text())
        return
    params = {"action": "parse", "page": title, "prop": "wikitext", "redirects": "1"}
    if section:
        params["section"] = section
    data = api(params)
    text = re.sub(r"<!--.*?-->", "", data["parse"]["wikitext"], flags=re.S)
    real = data["parse"]["title"]
    BLOBS.mkdir(exist_ok=True)
    blob.write_text(text)
    append_ledger("manifest", json.dumps({
        "slug": slug, "title": real, "url": canonical_url(real),
        "section": section, "sha1": hashlib.sha1(text.encode()).hexdigest()[:12],
        "bytes": len(text), "fetched": now()}))
    say(f"fetched {len(text)}B -> blobs/{blob.name}")
    print(strip_noise(text) if strip else text)


def _title_and_section(args):
    if not args:
        die("get needs a title")
    if "--section" not in args:
        return " ".join(args), None
    i = args.index("--section")
    return " ".join(args[:i]), args[i + 1]


def cmd_sections(args):
    if not args:
        die("sections needs a title")
    title = " ".join(args)
    data = api({"action": "parse", "page": title, "prop": "sections", "redirects": "1"})
    secs = data["parse"]["sections"]
    total = _page_length(title)
    for i, s in enumerate(secs):
        indent = "  " * (int(s.get("toclevel", 1)) - 1)
        print(f"{s['index']}\t{_section_size(secs, i, total)}\t{indent}{s['line']}")


def _page_length(title):
    data = api({"action": "query", "prop": "info", "titles": title, "redirects": "1"})
    pages = data.get("query", {}).get("pages", [])
    return pages[0].get("length", 0) if pages else 0


def _section_size(secs, i, total):
    """Size from byteoffset deltas; '?' when the offset is null (template-transcluded
    sections report no offset — a known undercount trap, see gotchas.log)."""
    start = secs[i].get("byteoffset")
    if start is None:
        return "?"
    nxt = next((s["byteoffset"] for s in secs[i + 1:] if s.get("byteoffset") is not None), total)
    return f"{max(0, (nxt or total) - start)}B"


def cmd_links(args):
    if not args:
        die("links needs a title")
    data = api({"action": "parse", "page": " ".join(args),
                "prop": "links", "redirects": "1"})
    mainspace = [l["title"] for l in data["parse"]["links"] if l.get("ns") == 0]
    print("\n".join(mainspace))


def cmd_members(args):
    if not args:
        die("members needs a category name")
    name = " ".join(args)
    name = name if name.startswith("Category:") else f"Category:{name}"
    data = api({"action": "query", "list": "categorymembers",
                "cmtitle": name, "cmlimit": "300"})
    print("\n".join(m["title"] for m in data["query"]["categorymembers"]))


def cmd_url(args):
    if not args:
        die("url needs a title")
    print(canonical_url(" ".join(args)))


def cmd_manifest(args):
    needle = args[0].lower() if args else ""
    rows = [r for r in ledger_rows("manifest") if needle in r["slug"].lower()]
    for r in rows:
        print(f"{r['slug']}\t{r['bytes']}B\t{r['title']}")
    say(f"{len(rows)} blob(s)")


def cmd_contribute(args):
    if not args:
        die("contribute needs a json payload with a \"key\"")
    raw = Path(args[1]).read_text() if args[0] == "--file" and len(args) > 1 else args[0]
    obj = parse_json_arg(raw, "contribution")
    key = obj.get("key")
    if not key:
        die("contribution needs a \"key\" field")
    seen = {r.get("key") for r in ledger_rows("contrib")}
    if key in seen:
        say(f"duplicate key, skipped: {key}")
        return
    append_ledger("contrib", json.dumps({**obj, "ts": now()}))
    say(f"contributed: {key}")


def cmd_queue(args):
    if not args:
        die("queue needs add|claim|done|list")
    sub, rest = args[0], args[1:]
    if sub == "list":
        return _queue_list(rest)
    if sub not in ("add", "claim", "done"):
        die(f"unknown queue subcommand: {sub}")
    if not rest:
        die(f"queue {sub} needs a key")
    key, payload = rest[0], (parse_json_arg(rest[1], "payload") if len(rest) > 1 else None)
    state = _queue_state()
    if sub == "add" and key in state:
        say(f"already queued ({state[key]['status']}), skipped: {key}")
        return
    status = {"add": "pending", "claim": "claimed", "done": "done"}[sub]
    append_ledger("queue", json.dumps({"key": key, "status": status,
                                       "payload": payload, "ts": now()}))
    say(f"{key} -> {status}")


def _queue_state():
    state = {}
    for r in ledger_rows("queue"):
        state[r["key"]] = r          # append-only; last record per key wins
    return state


def _queue_list(rest):
    want = rest[0] if rest else None
    rows = [r for r in _queue_state().values() if not want or r["status"] == want]
    for r in rows:
        extra = json.dumps(r["payload"]) if r.get("payload") else ""
        print(f"{r['status']}\t{r['key']}\t{extra}")
    say(f"{len(rows)} item(s)")


def cmd_feedback(args):
    if not args:
        die("feedback needs text")
    append_ledger("feedback", f"[{now()}] {' '.join(args)}")
    say("feedback logged — thank you")


COMMANDS = {
    "search": cmd_search, "get": cmd_get, "sections": cmd_sections,
    "links": cmd_links, "members": cmd_members, "url": cmd_url,
    "manifest": cmd_manifest, "contribute": cmd_contribute,
    "queue": cmd_queue, "feedback": cmd_feedback,
}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.exit(__doc__)
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        die(f"unknown command: {argv[0]} (try --help)")
    cmd(argv[1:])


if __name__ == "__main__":
    main()
